---
import ConsoleLayout from '../../layouts/ConsoleLayout.astro';
import BoardTerminal from '../../battle/ui/BoardTerminal.tsx';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<ConsoleLayout title="PUBLIC ROSTER · 명부 게시판" description="헌터 관리국 명부 게시판 — 등록된 참가자 프로필 전체 열람">
  <BoardTerminal client:only="react" />

  <span slot="foot">HUNTER MANAGEMENT AGENCY · PUBLIC ROSTER</span>
  <a slot="foot" href={`${base}/battle/join/`}>내 시트 · 참가 신청 →</a>
</ConsoleLayout>

---
import '../../styles/console.css';
import BoardTerminal from '../../battle/ui/BoardTerminal.tsx';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex" />
  <meta name="description" content="헌터 관리국 명부 게시판 — 등록된 참가자 프로필 전체 열람" />
  <title>PUBLIC ROSTER · 명부 게시판</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=Noto+Serif+KR:wght@500;700&display=swap"
    rel="stylesheet"
  />
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
  />
</head>
<body class="console-body">
  <BoardTerminal client:only="react" />
  <footer class="console">
    <div class="console-foot">
      <span>HUNTER MANAGEMENT AGENCY · PUBLIC ROSTER</span>
      <a href={`${base}/battle/join/`}>내 시트 · 참가 신청 →</a>
    </div>
  </footer>
</body>
</html>

---
import '../../styles/console.css';
import ControlTerminal from '../../battle/ui/ControlTerminal.tsx';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex" />
  <meta name="description" content="헌터 관리국 중앙 작전실 — 운영진 전투 관리" />
  <title>CENTRAL RAID CONTROL · 운영진 작전실</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=Noto+Serif+KR:wght@500;700&display=swap"
    rel="stylesheet"
  />
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
  />
</head>
<body class="console-body">
  <ControlTerminal client:only="react" />
  <footer class="console">
    <div class="console-foot">
      <span>HUNTER MANAGEMENT AGENCY · CENTRAL RAID CONTROL · PHASE 5 BUILD</span>
      <a href={`${base}/battle/`}>참가자 단말 →</a>
    </div>
  </footer>
</body>
</html>

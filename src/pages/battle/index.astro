---
import ConsoleLayout from '../../layouts/ConsoleLayout.astro';
import BattleTerminal from '../../battle/ui/BattleTerminal.tsx';

/** GitHub Pages 의 base 경로에서도 깨지지 않도록 항상 BASE_URL 기준으로 링크를 만든다. */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<ConsoleLayout title="TOWER RAID CONTROL SYSTEM · 전투 단말" description="헌터 관리국 탑 공략 통제 시스템 — 전투 진행 단말">
  <BattleTerminal client:only="react" />

  <span slot="foot">HUNTER MANAGEMENT AGENCY · TOWER RAID CONTROL · PHASE 1 BUILD</span>
  <a slot="foot" href={`${base}/`}>← 세계관 소개 페이지</a>
</ConsoleLayout>

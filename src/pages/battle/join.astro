---
import '../../styles/console.css';
import JoinTerminal from '../../battle/ui/JoinTerminal.tsx';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex" />
  <meta name="description" content="헌터 관리국 계약자 등록 — 캐릭터 시트 작성" />
  <title>CONTRACT REGISTRY · 계약자 등록</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=Noto+Serif+KR:wght@500;700&display=swap"
    rel="stylesheet"
  />
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
  />
</head>
<body class="console-body">
  <JoinTerminal client:only="react" />
  <footer class="console">
    <div class="console-foot">
      <span>HUNTER MANAGEMENT AGENCY · CONTRACT REGISTRY · PHASE 1 BUILD</span>
      <a href={`${base}/`}>← 세계관 소개 페이지</a>
    </div>
  </footer>
</body>
</html>
